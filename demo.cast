[1.571, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3Gopens\u001b[9Gthe\u001b[13Gcontrolling\u001b[25Gtty\u001b[29Gfor\u001b[33Gwrites\u001b[40Gand\u001b[44Gemits\u001b[50GKitty\u001b[56Ggraphics\u001b[65Gescapes\u001b[73Gdirectly\u001b[82G—\u001b[84Git\u001b[87Gnever\u001b[93Gsees\u001b[98Gor\u001b[101Gbuffers\u001b[109GClaude's\r\u001b[2C\u001b[1BI/O.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mHooks drive the lifecycle.\u001b[22m \u001b[38;2;177;185;249mUserPromptSubmit\u001b[39m \u001b[50Gp\u001b[52Gwns/nudges the\u001b[67Gdaemon; \u001b[38;2;177;185;249mStop\u001b[39m send\u001b[86G\u001b[38;2;177;185;249mIDLE\u001b[39m (banner\u001b[99Gflips\u001b[105Gto\u001b[108G\"✓\u001b[111GClaude\r\u001b[2C\u001b[1Bis done\"). A prompt hook int\u001b[32Grcepts \u001b[38;2;177;185;249mp:\u001b[39m commands \u001b[52Gnd\u001b[55Gblocks them before Claude sees them.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1m~60 Hz redraw loop\u001b[24G\u001b[22mre-places\u001b[34Gthe\u001b[38Gsame\u001b[43GKitty\u001b[49Gimage\u001b[55GID\u001b[58Gso\u001b[61Gthe\u001b[65Gboard\u001b[71Gsnaps\u001b[77Gback\u001b[82Gabove\u001b[88Gscrolls,\u001b[97Gplus\u001b[102G\u001b[38;2;177;185;249mSIGWINCH\u001b[111G\u001b[39mhandling\r\u001b[2C\u001b[1Bfor resizes.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mOne daemon per tty\u001b[24G\u001b[22m(PID\u001b[29Gfile\u001b[34G+\u001b[36GUnix\u001b[41Gdatagram\u001b[50Gsocket\u001b[57Gkeyed\u001b[63Gon\u001b[66Ga\u001b[68Ghash\u001b[73Gof\u001b[76Gthe\u001b[80Gtty\u001b[84Gname),\u001b[91Gso\u001b[94Gt"]
