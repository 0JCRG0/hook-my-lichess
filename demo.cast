[0.000, "o", "\u001b[69Gas\u001b[72Gplain\u001b[78Gtext,\u001b[84Gmitigated\u001b[94Gby\u001b[97Gan\u001b[100Ginjected\u001b[109G\"ignore\r\u001b[2C\u001b[1Bthese\"\u001b[10Ginstruction.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 15s\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;193;7m⏺\u001b[3GUserPro\u001b[11GptSubm\u001b[18Gt op\u001b[23Gration blocked by hook:\r\u001b[2C\u001b[1Bpuzzle move: size medium\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;255;193;7mOriginal prompt: p:size medium\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;193;7m⏺\u001b[3GUserPro\u001b[11GptSubm\u001b[18Gt operation blocked by hook:\r\u001b[2C\u001b[1Bpuzzle move: size 4\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;255;193;7mOriginal prompt: p:size 4\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;193;7m⏺\u001b[3GUserPromptSubmit operation blocked by hook:\r\u001b[2C\u001b[1Bpuzzle: hint\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;255;193;7mOriginal prompt: p:hint\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;193;7m⏺\u001b[3GUserPromptSubmit operation blocked by hook:\r\u001b[2C\u001b[1Bpuzzle: quit\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;255;193;7mOriginal prompt: p:quit\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;136;136;136m────────────────────────────"]
