[0.811, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3GI/O.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mHooks drive the lifecycle.\u001b[32G\u001b[22m\u001b[38;2;177;185;249mUserPromptSubmit\u001b[49G\u001b[39mspawns/nudges\u001b[63Gthe\u001b[67Gdaemon;\u001b[75G\u001b[38;2;177;185;249mStop\u001b[80G\u001b[39msends\u001b[86G\u001b[38;2;177;185;249mIDLE\u001b[91G\u001b[39m(banner\u001b[99Gflips\u001b[105Gto\u001b[108G\"✓\u001b[111GClaude\r\u001b[2C\u001b[1Bis done\"). A prompt hook intercepts \u001b[38;2;177;185;249mp:\u001b[39m command\u001b[50G \u001b[52Gnd blocks them\u001b[67Gbefore Claude see\u001b[86Gthem.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1m~60 Hz redraw loop\u001b[22m re-plac\u001b[32Gs the same Kitty im\u001b[52Gge\u001b[55GID so the board snaps back above scrolls,\u001b[97Gplus\u001b[102G\u001b[38;2;177;185;249mSIGWINCH\u001b[111G\u001b[39mhandling\r\u001b[2C\u001b[1Bfor resizes.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mOne daemon per tty\u001b[24G\u001b[22m(PID\u001b[29Gfile\u001b[34G+\u001b[36GUnix\u001b[41Gdatagram\u001b[50Gsocket\u001b[57Gkeyed\u001b[63Gon\u001b[66Ga\u001b[68Ghash\u001b[73Gof\u001b[76Gthe\u001b[80Gtty\u001b[84Gname),\u001b[91Gso\u001b[94Gtwo\u001b[98GClaudes\u001b[106Gin\u001b[109Gtwo\u001b[113Gpanes\r\u001b[2C\u001b[1Bcoexist.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLayout:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B┌────────────────────┬──────────"]
